<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/flagIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="12dp"
        android:src="@drawable/baseline_flag_24"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/holo_blue_light"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/labelView"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="10dp"
        android:text="@string/app_name"
        android:textColor="@color/titleOnBackground"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/pkgView"
        app:layout_constraintEnd_toStartOf="@id/flagIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="12dp" />

    <TextView
        android:id="@+id/pkgView"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/summaryOnBackground"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/timeView"
        app:layout_constraintEnd_toEndOf="@id/labelView"
        app:layout_constraintStart_toStartOf="@id/labelView"
        app:layout_constraintTop_toBottomOf="@id/labelView" />

    <TextView
        android:id="@+id/timeView"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="12dp"
        android:gravity="end"
        android:text="@string/app_name"
        android:textColor="#3B8CA6"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/flagIcon"
        app:layout_constraintStart_toStartOf="@id/pkgView"
        app:layout_constraintTop_toBottomOf="@id/pkgView"
        app:layout_goneMarginEnd="12dp" />

    <View
        android:layout_width="0px"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:alpha="0.6"
        android:background="@color/summaryOnBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>