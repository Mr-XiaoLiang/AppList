<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_float_hook">

    <TextView
        android:id="@+id/infoView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="2dp"
        android:paddingStart="12dp"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="240dp"
        tools:text="com.lollipop.applist\ncom.lollipop.applist.MainActivity com.lollipop.applist.MainActivity" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/flagButton"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:src="@drawable/baseline_flag_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/infoView"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/color_flag_button" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/refreshButton"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:src="@drawable/outline_autorenew_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/infoView"
        app:layout_constraintTop_toBottomOf="@id/flagButton"
        app:tint="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>